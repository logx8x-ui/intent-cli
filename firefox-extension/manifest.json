{
  "manifest_version": 2,
  "name": "Intent Browser Guard",
  "version": "0.2.2",
  "description": "Enforces active Intent browser rules inside Firefox.",
  "icons": {
    "48": "icons/intent-48.svg",
    "96": "icons/intent-96.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "intent-firefox@loganmondi.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Intent Browser Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/intent-48.svg",
      "96": "icons/intent-96.svg"
    }
  },
  "background": {
    "scripts": [
      "rule-helpers.js",
      "background.js"
    ]
  }
}
